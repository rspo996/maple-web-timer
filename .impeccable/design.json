  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default chunky button with inner bottom bevel.",
      "html": "<button class=\"ds-btn\">소리 시험</button>",
      "css": ".ds-btn{font:14px/1.35 'Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;color:var(--ink,#3b2814);background:var(--btn,#fff6e6);border:1.5px solid var(--btn-edge,#c99d68);border-radius:9px;padding:5px 12px 6px;cursor:pointer;box-shadow:inset 0 -2px 0 var(--btn-shade,rgba(120,75,30,.24)),inset 0 1px 0 var(--btn-hi,#fff);transition:transform .12s cubic-bezier(.16,1,.3,1),filter .15s,border-color .15s}.ds-btn:hover{border-color:var(--rim,#5c3a1a);filter:brightness(1.05)}.ds-btn:active{transform:translateY(1px);box-shadow:inset 0 2px 3px var(--btn-shade,rgba(120,75,30,.24))}.ds-btn:focus-visible{outline:3px solid var(--focus,#2a6fc9);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Coin Gold call to action; one per screen.",
      "html": "<button class=\"ds-btn-primary\">게임 화면 연결</button>",
      "css": ".ds-btn-primary{font:700 15px/1.35 'Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;color:var(--accent-ink,#3b2208);background:var(--accent,#ffc53d) linear-gradient(var(--accent-hi,#ffe390),var(--accent,#ffc53d) 62%);border:1.5px solid var(--accent-edge,#b9780f);border-radius:9px;padding:7px 16px 8px;cursor:pointer;box-shadow:inset 0 -3px 0 color-mix(in srgb,var(--accent-edge,#b9780f) 60%,transparent),inset 0 1px 0 rgba(255,255,255,.6);transition:transform .12s cubic-bezier(.16,1,.3,1),filter .15s}.ds-btn-primary:hover{filter:brightness(1.05)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:3px solid var(--focus,#2a6fc9);outline-offset:2px}"
    },
    {
      "name": "Duration Chip",
      "kind": "chip",
      "refersTo": "button-chip",
      "description": "Pill preset button in Jua.",
      "html": "<button class=\"ds-chip\">3분</button>",
      "css": ".ds-chip{font:16px/1.3 'Jua Tabular','Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;color:var(--ink,#3b2814);background:var(--btn,#fff6e6);border:1.5px solid var(--btn-edge,#c99d68);border-radius:999px;padding:3px 13px 4px;cursor:pointer;box-shadow:inset 0 -2px 0 var(--btn-shade,rgba(120,75,30,.24)),inset 0 1px 0 var(--btn-hi,#fff)}.ds-chip:hover{border-color:var(--rim,#5c3a1a)}.ds-chip:focus-visible{outline:3px solid var(--focus,#2a6fc9);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Sunk white field with orange caret.",
      "html": "<input class=\"ds-input\" placeholder=\"이름\">",
      "css": ".ds-input{font:15px/1.5 'Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;color:var(--ink,#3b2814);background:var(--field,#fff);border:1.5px solid var(--field-line,#cfb48b);border-radius:7px;padding:4px 8px;box-shadow:inset 0 2px 2px -1px var(--well-shade,rgba(120,80,30,.16));caret-color:var(--control,#d9741a)}.ds-input::placeholder{color:var(--muted,#7a5f45)}.ds-input:focus-visible{outline:3px solid var(--focus,#2a6fc9);outline-offset:1px;border-color:var(--focus,#2a6fc9)}"
    },
    {
      "name": "Game Window",
      "kind": "card",
      "refersTo": "window",
      "description": "Rim, wood frame with inner bevel, ember title bar, parchment body.",
      "html": "<section class=\"ds-win\"><h2 class=\"ds-wbar\">수동 타이머</h2><div class=\"ds-wbody\">창 본문</div></section>",
      "css": ".ds-win{background:var(--frame,#c98d4f);border:2px solid var(--rim,#5c3a1a);border-radius:15px;padding:4px;box-shadow:inset 0 0 0 1px var(--frame-hi,#efc58f),0 12px 26px -16px var(--shadow,rgba(70,40,10,.38))}.ds-wbar{margin:0;padding:6px 14px 7px;border-radius:10px 10px 0 0;background:linear-gradient(var(--bar-hi,#ffad55),var(--bar,#e8791f) 72%);border:1.5px solid var(--bar-edge,#9c4e12);border-bottom-width:2px;color:var(--bar-ink,#fff);font:400 20px/1.25 'Jua Tabular','Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;letter-spacing:.01em;text-shadow:-1.5px 0 var(--bar-o,#6e3207),1.5px 0 var(--bar-o,#6e3207),0 -1.5px var(--bar-o,#6e3207),0 1.5px var(--bar-o,#6e3207),0 2.5px var(--bar-o,#6e3207)}.ds-wbody{background:var(--panel,#fffaf0);color:var(--ink,#3b2814);border-radius:0 0 10px 10px;padding:14px;font:15px/1.5 'Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif}"
    },
    {
      "name": "Collapsed Window Bar",
      "kind": "custom",
      "refersTo": "window-title-bar-shut",
      "description": "Closed <details> window: Shut Wood bar with chevron.",
      "html": "<div class=\"ds-win-shut\"><div class=\"ds-shut\">설정 백업 <span class=\"ds-shut-sub\">파일로 내보내기·불러오기</span><span class=\"ds-chev\"><svg viewBox=\"0 0 14 10\" width=\"15\" height=\"11\"><path d=\"M2 2.5l5 5 5-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></div></div>",
      "css": ".ds-win-shut{background:var(--frame,#c98d4f);border:2px solid var(--rim,#5c3a1a);border-radius:15px;padding:4px;box-shadow:inset 0 0 0 1px var(--frame-hi,#efc58f)}.ds-shut{display:flex;align-items:center;gap:10px;padding:6px 14px 7px;border-radius:10px;background:linear-gradient(var(--shut-hi,#d09a5c),var(--shut,#a8713c) 72%);border:1.5px solid var(--shut-edge,#6e4419);color:#fff;font:400 20px/1.25 'Jua Tabular','Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;text-shadow:-1.5px 0 var(--bar-o,#6e3207),1.5px 0 var(--bar-o,#6e3207),0 -1.5px var(--bar-o,#6e3207),0 1.5px var(--bar-o,#6e3207),0 2.5px var(--bar-o,#6e3207);cursor:pointer}.ds-shut:hover{filter:brightness(1.06)}.ds-shut-sub{font:13px/1.3 'Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;color:var(--shut-sub,#1f0e02);text-shadow:none}.ds-chev{margin-left:auto;display:flex;color:var(--bar-chev,#6e3207)}"
    },
    {
      "name": "Buff Slot Row with Gauge",
      "kind": "custom",
      "refersTo": "slot-well",
      "description": "Inset well row: beveled 38px slot, Jua name and mini state, draining pill gauge.",
      "html": "<div class=\"ds-slotrow\"><div class=\"ds-top\"><span class=\"ds-slot\"></span><div><div class=\"ds-name\">솔 야누스</div><div class=\"ds-mini\">켜져 있어요 · 2:41</div></div></div><div class=\"ds-gauge\"><i style=\"transform:scaleX(.62)\"></i></div></div>",
      "css": ".ds-slotrow{background:var(--well,#f7ecd9);border:1.5px solid var(--well-line,#e3cfae);border-radius:11px;padding:6px 10px;box-shadow:inset 0 2px 3px -1px var(--well-shade,rgba(120,80,30,.16));max-width:340px}.ds-top{display:flex;gap:10px;align-items:center}.ds-slot{width:38px;height:38px;flex:none;border-radius:8px;background:#05070d;border:2px solid var(--slot-rim,#3d2611);box-shadow:inset 0 0 0 1px var(--slot-hi,rgba(255,255,255,.18))}.ds-name{font:400 18px/1.1 'Jua Tabular','Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;color:var(--ink,#3b2814)}.ds-mini{font:400 15px/1.1 'Jua Tabular','Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;color:var(--ok,#23803a)}.ds-gauge{position:relative;height:8px;margin-top:5px;border-radius:999px;background:var(--gauge-bg,#3d2a17);border:1.5px solid var(--rim,#5c3a1a);overflow:hidden}.ds-gauge i{position:absolute;inset:0;border-radius:inherit;transform-origin:left center;background:linear-gradient(var(--fill-hi,#9bd8ff),var(--fill,#3b9cf0) 55%,var(--fill-lo,#1f6cc4));transition:transform .5s linear}.ds-gauge::after{content:'';position:absolute;left:4px;right:4px;top:1px;height:2px;border-radius:2px;background:rgba(255,255,255,.4)}"
    },
    {
      "name": "Status Window",
      "kind": "custom",
      "refersTo": "status-window",
      "description": "Full-width watch window with state gem and tint.",
      "html": "<div class=\"ds-watch\"><span class=\"ds-gem\"></span><span class=\"ds-state\">감시 중</span><span class=\"ds-targets\">솔 야누스 · 룬</span></div>",
      "css": ".ds-watch{display:flex;align-items:center;gap:8px 16px;padding:12px 20px;min-height:62px;font:14px/1.5 'Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;color:var(--ink,#3b2814);background:color-mix(in srgb,var(--ok-fill,#46bd5a) 13%,var(--panel,#fffaf0));border:2px solid var(--rim,#5c3a1a);border-radius:15px;box-shadow:inset 0 0 0 4px var(--frame,#c98d4f),inset 0 0 0 5px var(--frame-hi,#efc58f),0 12px 26px -16px var(--shadow,rgba(70,40,10,.38))}.ds-gem{width:20px;height:20px;border-radius:50%;border:2px solid var(--rim,#5c3a1a);background:radial-gradient(circle at 34% 30%,rgba(255,255,255,.9) 0 16%,rgba(255,255,255,0) 26%),radial-gradient(circle at 50% 75%,rgba(0,0,0,0) 40%,rgba(0,0,0,.28) 100%),var(--ok-fill,#46bd5a)}.ds-state{font:400 23px/1.2 'Jua Tabular','Pretendard','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;color:var(--ok,#23803a)}"
    },
    {
      "name": "Timer Numerals",
      "kind": "custom",
      "refersTo": "numeral",
      "description": "Outlined, drop-stamped Jua Tabular countdown.",
