    "shadows": [
      {
        "name": "window",
        "value": "inset 0 0 0 1px var(--frame-hi), 0 12px 26px -16px var(--shadow)",
        "purpose": "Every game window."
      },
      {
        "name": "status-window",
        "value": "inset 0 0 0 4px var(--frame), inset 0 0 0 5px var(--frame-hi), 0 12px 26px -16px var(--shadow)",
        "purpose": "Status window and (3px) undo bar: frame drawn as inset rings."
      },
      {
        "name": "button-bevel",
        "value": "inset 0 -2px 0 var(--btn-shade), inset 0 1px 0 var(--btn-hi)",
        "purpose": "Default button at rest."
      },
      {
        "name": "button-pressed",
        "value": "inset 0 2px 3px var(--btn-shade)",
        "purpose": "Button :active."
      },
      {
        "name": "primary-bevel",
        "value": "inset 0 -3px 0 color-mix(in srgb, var(--accent-edge) 60%, transparent), inset 0 1px 0 rgba(255,255,255,.6)",
        "purpose": "Primary button."
      },
      {
        "name": "well",
        "value": "inset 0 2px 3px -1px var(--well-shade)",
        "purpose": "Target rows, add menu; fields use inset 0 2px 2px -1px."
      },
      {
        "name": "toast",
        "value": "inset 0 2px 0 rgba(255,255,255,.25), 0 14px 30px -10px rgba(0,0,0,.5)",
        "purpose": "Alert toast."
      },
      {
        "name": "dialog",
        "value": "inset 0 0 0 1px var(--frame-hi), 0 24px 50px -14px rgba(0,0,0,.55)",
        "purpose": "Import dialog."
      }
    ],
